    "requires": [
      "team-smoke"
    ],
    "cmd": [
      "bash",
      "team/run_screen.sh",
      "S2",
      "--lr",
      "2e-4",
      "--backbone-lr",
      "6e-4"
    ],
    "run_dir": "runs/team/S2",
    "max_hours": 6,
    "resumable": false,
    "collect": [
      "runs/team/S2/log.txt",
      "runs/team/S2/metrics.json",
      "runs/team/S2/metrics_pp.json"
    ],
    "enabled": false
  },
  {
    "name": "team-S3",
