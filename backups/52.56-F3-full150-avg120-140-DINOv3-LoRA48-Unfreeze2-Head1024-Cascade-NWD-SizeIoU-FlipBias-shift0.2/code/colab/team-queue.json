    "run_dir": "runs/team/S3",
    "max_hours": 6,
    "resumable": false,
    "collect": [
      "runs/team/S3/log.txt",
      "runs/team/S3/metrics.json",
      "runs/team/S3/metrics_pp.json"
    ]
  },
