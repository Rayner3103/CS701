[
  {
    "name": "team-smoke",
    "worker": "T1",
    "cmd": [
      "bash",
      "team/smoke.sh"
    ],
    "run_dir": "runs/team-smoke",
    "max_hours": 1.5,
    "resumable": false,
    "collect": [
      "runs/team-smoke/params.txt",
      "runs/team-smoke/B0/log.txt"
    ]
  },
  {
    "name": "team-B0",
    "worker": "T1",
    "requires": [
      "team-smoke"
    ],
    "cmd": [
      "bash",
      "team/run_screen.sh",
      "B0"
    ],
    "run_dir": "runs/team/B0",
    "max_hours": 6,
    "resumable": false,
    "collect": [
      "runs/team/B0/log.txt",
      "runs/team/B0/metrics.json",
      "runs/team/B0/metrics_pp.json"
    ]
  },
  {
    "name": "team-S1",
    "worker": "T2",
    "requires": [
      "team-smoke"
    ],
    "cmd": [
      "bash",
      "team/run_screen.sh",
      "S1",
      "--spatial-prior",
      "64"
    ],
    "run_dir": "runs/team/S1",
    "max_hours": 6,
    "resumable": false,
    "collect": [
      "runs/team/S1/log.txt",
      "runs/team/S1/metrics.json",
      "runs/team/S1/metrics_pp.json"
    ]
  },
  {
    "name": "team-S2",
